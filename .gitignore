# ==============================================================================
# ElevateIQ (ELVIQ MEET) — .gitignore
# ==============================================================================

# ── Environment & Secrets (CRITICAL) ──────────────────────────────────────────
.env
.env.*
*.env
backend/.env
frontend/.env
!.env.example
!backend/.env.example

# ── Python Virtual Environments & Packages ────────────────────────────────────
venv/
env/
ENV/
.venv/
backend/venv/
backend/env/
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# ── Local Databases ───────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
backend/elevateiq.db

# ── User Uploads & Media Storage ──────────────────────────────────────────────
uploads/
backend/uploads/
backend/uploads/*
uploads/*
!backend/uploads/.gitkeep
!uploads/.gitkeep

# ── Node & Frontend Artifacts ─────────────────────────────────────────────────
node_modules/
frontend/node_modules/
**/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local
.tsbuildinfo
tsconfig.app.tsbuildinfo

# ── Logs & Debugging ──────────────────────────────────────────────────────────
logs/
backend/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Android & Mobile Artifacts ────────────────────────────────────────────────
*.apk
*.aab
.gradle/
**/build/
frontend/android/.gradle/
frontend/android/app/build/
frontend/android/local.properties

# ── IDEs & OS ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
# ── Test export artifacts ──────────────────────────────────────────────────
compliance_exports_test/
dsar_exports_flow_test/
uploads_test/
