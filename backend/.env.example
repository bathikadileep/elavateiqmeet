# ElevateIQ Backend Configuration Example

# Core Flask Config
SECRET_KEY=generate-a-secure-random-key-here
JWT_SECRET_KEY=generate-another-secure-random-jwt-key

# Database Connection (Neon PostgreSQL String)
# Example: postgres://username:password@ep-cool-snowflake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# CORS Settings (comma-separated list of origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security Settings
JWT_COOKIE_SECURE=False  # Set to True in production with HTTPS
